<Window x:Class="EtNotif.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EtNotif - Mükellef Yönetimi" Height="450" Width="800">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <Label Content="VKN" VerticalAlignment="Center" />
            <TextBox x:Name="VknBox" Width="150" Margin="4,0,8,0"/>
            <Label Content="Ad" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Width="200" Margin="4,0,8,0"/>
            <Label Content="Şifre" VerticalAlignment="Center" />
            <PasswordBox x:Name="PasswordBox" Width="200" Margin="4,0,8,0" />
            <Button Content="Ekle" Click="Add_Click"/>
        </StackPanel>

        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="VKN" Binding="{Binding Vkn}" Width="150"/>
                <DataGridTextColumn Header="Ad" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="Son Kontrol" Binding="{Binding LastCheckedAt}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="2">
            <TextBlock x:Name="StatusText">Hazır</TextBlock>
        </StatusBar>
    </Grid>
</Window>
